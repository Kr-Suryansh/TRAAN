# .env.example — sih-dashboard
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file containing actual secrets.

# ── Backend API ─────────────────────────────────────────────
# Base URL for the sih-backend REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── WebSocket ────────────────────────────────────────────────
# WS URL for live incident updates (matches WS /ws/incidents in contract)
VITE_WS_URL=ws://localhost:8000/ws/incidents

# ── Mock mode ────────────────────────────────────────────────
# Set to 'false' (default) to use the real backend. 'true' = Phase 1 mock data.
VITE_MOCK_MODE=false
