# --------------------------------------------------
# sih-backend — Environment Variables
# --------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file to Git.
# --------------------------------------------------

# Google Gemini API key (required for AI summarization & situation briefs)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (required when backend core / DB layer is integrated)
# DATABASE_URL=postgresql://user:password@localhost:5432/sih_db

# JWT secret for authority authentication (required when auth is integrated)
# JWT_SECRET=your_jwt_secret_here
