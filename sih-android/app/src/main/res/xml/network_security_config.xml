<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration — debug only.

    Android 9+ blocks cleartext (HTTP) by default. For local development and
    emulator testing, we allow cleartext to 10.0.2.2 (emulator loopback to the
    host machine where Agent D's backend runs).

    This file is only referenced from the debug manifest override below; the
    release build uses the platform default (cleartext blocked everywhere).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator loopback → host machine (where the dev backend runs) -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- LAN testing from a physical device — replace with actual dev machine IP -->
        <domain includeSubdomains="false">192.168.1.0</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
